# -----------------------------------------------------------------------
# Environment variables — copy this file to .env and fill in real values
# DO NOT commit .env to version control
# -----------------------------------------------------------------------

# ── YouTube Transcript Pipeline ─────────────────────────────────────────
# JSON array of YouTube playlist URLs to process
YOUTUBE_PLAYLISTS=["https://www.youtube.com/playlist?list=YOUR_PLAYLIST_ID"]
# Comma-separated language codes (tried in order)
TRANSCRIPT_LANGS=vi,en
# Directory where .trans.txt files will be saved
TRANSCRIPT_OUTPUT_DIR=./transcripts
# File that tracks already-processed video IDs
LOCK_FILE=./video-id-locked.txt

# ── Paths ───────────────────────────────────────────────────────────────
DATA_DIR=./data
OUTPUT_DIR=./output
MODEL_DIR=./models

# ── Training ────────────────────────────────────────────────────────────
BATCH_SIZE=8
LEARNING_RATE=5e-5
NUM_EPOCHS=3
MAX_SEQ_LENGTH=512
SEED=42

# ── Logging / Experiment tracking ───────────────────────────────────────
LOG_LEVEL=INFO
WANDB_PROJECT=finetune-sherpa-vi
WANDB_API_KEY=

# ── HuggingFace ─────────────────────────────────────────────────────────
HF_TOKEN=
HF_HOME=~/.cache/huggingface

# ── CUDA ────────────────────────────────────────────────────────────────
CUDA_VISIBLE_DEVICES=0

# ── Context Inference (feature/context-inference) ────────────────────────
# Folder chứa các file .trans.txt cần xử lý (output của youtube transcript pipeline)
CONTEXT_INPUT_DIR=./transcripts
# Folder lưu kết quả (*-context.trans.txt)
CONTEXT_OUTPUT_DIR=./context_output
# Model Ollama dùng để suy luận ngữ cảnh
CONTEXT_MODEL=qwen2.5:3b
# Số file xử lý song song (khuyến nghị <= 2 để tránh quá tải GPU)
CONTEXT_MAX_WORKERS=2
# Số từ tối thiểu để một dòng được xem là hợp lệ (< số này sẽ bị bỏ qua + log)
CONTEXT_MIN_WORDS=4
# Số dòng gửi cho model trong 1 lần request (tăng nếu file dài, giảm nếu timeout)
CONTEXT_CHUNK_SIZE=50
# Timeout của mỗi request gửi Ollama (giây)
CONTEXT_TIMEOUT=120
# Độ ngẫu nhiên của model (0.0 = tất định, 1.0 = sáng tạo cao)
CONTEXT_TEMPERATURE=0.3

# ── Ollama ───────────────────────────────────────────────────────────────
# URL của Ollama server (mặc định localhost)
OLLAMA_HOST=http://localhost:11434
