# -----------------------------------------------------------------------
# Environment variables — copy this file to .env and fill in real values
# DO NOT commit .env to version control
# -----------------------------------------------------------------------

# ── YouTube Transcript Pipeline ─────────────────────────────────────────
# JSON array of YouTube playlist URLs to process
YOUTUBE_PLAYLISTS=["https://www.youtube.com/playlist?list=YOUR_PLAYLIST_ID"]
# Comma-separated language codes (tried in order)
TRANSCRIPT_LANGS=vi,en
# Directory where .trans.txt files will be saved
TRANSCRIPT_OUTPUT_DIR=./transcripts
# File that tracks already-processed video IDs
LOCK_FILE=./video-id-locked.txt

# ── Paths ───────────────────────────────────────────────────────────────
DATA_DIR=./data
OUTPUT_DIR=./output
MODEL_DIR=./models

# ── Training ────────────────────────────────────────────────────────────
BATCH_SIZE=8
LEARNING_RATE=5e-5
NUM_EPOCHS=3
MAX_SEQ_LENGTH=512
SEED=42

# ── Logging / Experiment tracking ───────────────────────────────────────
LOG_LEVEL=INFO
WANDB_PROJECT=finetune-sherpa-vi
WANDB_API_KEY=

# ── HuggingFace ─────────────────────────────────────────────────────────
HF_TOKEN=
HF_HOME=~/.cache/huggingface

# ── CUDA ────────────────────────────────────────────────────────────────
CUDA_VISIBLE_DEVICES=0
